#include <iostream>
#include <string>
#include <vector>

using namespace std;


bool check(string &s){

    string s1 = "";
    string s2 = "";
    int len = s.size() / 2;

    // s가 홀수
    if(s.size() %2 == 1){
        for(int i = 0; i < len; i++) s1 += s[i];
        for(int i = (int)s.size() - 1; i > len; i--) s2 += s[i];
    }
    else{
        for(int i = 0; i < len; i++) s1 += s[i];
        for(int i = (int)s.size() - 1; i >= len; i--) s2 += s[i];
    }
    

    return s1 == s2;
}

int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    for(int TC = 1; TC <= 10; TC++){
        int ans = 0;
        int len; 
        cin >> len;

        vector<vector<char>> board(8, vector<char>(8));

        for(int i = 0; i < 8; i++){
            string s;
            cin >> s;
            for(int j = 0; j < 8; j++) board[i][j] = s[j];
        }

        
        // 1. 가로
        for(int i = 0; i < 8; i++){
            for(int j = 0; j + len - 1 < 8; j++){
                string s = "";
                for(int k = j; k < j + len; k++){
                    s += board[i][k];
                }
                if(check(s)) ans++;
            }
        }

        // 2. 세로
        for(int i = 0; i < 8; i++){
            for(int j = 0; j + len - 1 < 8; j++){
                string s = "";
                for(int k = j; k < j + len; k++){
                    s += board[k][i];
                }
                if(check(s)) ans++;
            }
        }

        cout << "#" << TC << " " << ans << "\n";
    }

    return 0;
}